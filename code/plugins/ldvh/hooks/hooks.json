{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/session_start.py\"",
            "timeout": 30,
            "statusMessage": "Loading LDVH governance context"
          }
        ]
      }
    ]
  }
}
