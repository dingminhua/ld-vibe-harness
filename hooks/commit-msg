#!/bin/sh
# LDVH commit-msg hook.
#
# ```yaml
# ldvh_asset:
#   id: "ldvh-commit-msg-hook"
#   type: "hook"
#   status: "active"
#   canonical_path: "hooks/commit-msg"
#   source_specs:
#     - "specs/10-Git提交规范.md"
#     - "specs/04.02-LDVH能力资产与落地保障规范.md"
#   consumption_scenarios:
#     - "LDVH 自身仓库 Git commit message 本地前置校验"
#     - "AI 或 Human 创建提交前的即时反馈"
#   inputs:
#     - "Git commit-msg hook 传入的 commit message 文件路径"
#     - "当前 staged files"
#   outputs:
#     - "commit_validate.py 预检结果"
#     - "非零退出码阻断本地提交"
#   handoff: "失败时回到提交执行者修改 commit message，必要时按 specs/10 人工降级检查。"
#   verification:
#     - "hooks/commit-msg <message-file>"
#     - "python3 code/commit_validate.py --check-message '<message>'"
#     - "python3 code/specs_validate.py deployment-entries"
#   sync_triggers:
#     - "specs/10-Git提交规范.md 提交格式或门禁规则变化"
#     - "code/commit_validate.py CLI 参数或错误等级变化"
#     - "specs/04.02-LDVH能力资产与落地保障规范.md Hook 资产规则变化"
#   deprecation: "废弃或替换前必须同步 specs/10、04.02、0074 和等价 CI / server-side gate 说明。"
# ```
#
# Hook contract:
# - event: Git commit-msg
# - matcher / inputs: first argument is the message file path supplied by Git.
# - command: python3 code/commit_validate.py --check-message "$message"
# - timeout: no hook-local timeout; keep validator lightweight and deterministic.
# - file mutation: none.
# - exit code: validator error exits non-zero and blocks local commit; warnings do not block.
# - trust / bypass: local Git hooks can be bypassed with --no-verify, so this hook never
#   replaces specs/10, code/commit_validate.py, CI / server-side checks, Human Gate, or
#   Git commit records.
# - equivalent rerun: python3 code/commit_validate.py --check-message "$(cat .git/COMMIT_EDITMSG)".

set -eu

message_file="${1:-}"
if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  echo "LDVH commit-msg hook: missing commit message file." >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

if ! command -v python3 >/dev/null 2>&1; then
  echo "LDVH commit-msg hook: python3 is required to run code/commit_validate.py." >&2
  exit 1
fi

message="$(cat "$message_file")"
python3 code/commit_validate.py --check-message "$message"
