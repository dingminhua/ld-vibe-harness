#!/usr/bin/env python3
# Git Hook adapters select python3/python before invoking this source launcher;
# keep this shebang explicit so direct POSIX execution remains deterministic.
"""Stable source launcher for every LDVH runtime surface."""

from __future__ import annotations

import importlib.util
import os
import subprocess
import sys
from pathlib import Path

SOURCE_ROOT = Path(__file__).resolve().parent
CODE_ROOT = SOURCE_ROOT / "code"


def _ruamel_yaml_available() -> bool:
    try:
        return importlib.util.find_spec("ruamel.yaml") is not None
    except ModuleNotFoundError:
        # The parent ``ruamel`` namespace package is absent; the dependency is not installed.
        return False


def _runtime_typing_compatible() -> bool:
    """The codebase imports ``typing.assert_never`` (Python 3.11+) at module load.

    The launcher itself must start on an older interpreter (e.g. the system Python 3.10
    on Windows) long enough to detect this and hand off to a newer venv; without this
    check the interpreter would crash on the first ``from typing import assert_never``.
    """
    if sys.version_info < (3, 11):
        return False
    try:
        from typing import assert_never  # noqa: F401
    except ImportError:
        return False
    return True


def _dependency_runtime_ready() -> bool:
    return _ruamel_yaml_available() and _runtime_typing_compatible()


def _runtime_unavailable_message() -> str:
    lines = [
        "LDVH source runtime is unavailable",
        f"worktree: {SOURCE_ROOT}",
        f"python: {sys.executable or 'unavailable'}",
    ]
    if not _runtime_typing_compatible():
        lines.extend(("python_requirement: Python 3.11+", "runtime_issue: unsupported Python typing runtime"))
    if not _ruamel_yaml_available():
        lines.extend(("missing_package: ruamel.yaml", "requirements_file: requirements.txt"))
    lines.extend(
        (
            "status: unavailable",
            "Prepare declared third-party dependencies without installing LDVH itself:",
            "1. ./ldvh worktree-bootstrap",
            "2. ./ldvh worktree-bootstrap --check",
        )
    )
    return "\n".join(lines) + "\n"


def _handoff(candidate: Path, source: Path) -> None:
    """Replace the current process with the venv interpreter, preserving the exit code.

    On POSIX ``os.execv`` atomically replaces the image, so the child's exit code
    propagates naturally.  On Windows ``os.execv`` is emulated: it spawns a child and
    waits, then returns — so the return value must be forwarded to the shell
    explicitly, or every gate/doctor/probe would observe rc 0 regardless of outcome.
    """
    if os.name == "nt":
        completed = subprocess.run(
            [str(candidate), str(source), *sys.argv[1:]],
            check=False,
        )
        raise SystemExit(completed.returncode)
    os.execv(str(candidate), [str(candidate), str(source), *sys.argv[1:]])
    raise SystemExit(1)


def _ensure_dependency_runtime() -> None:
    if _dependency_runtime_ready():
        return
    candidates = (
        SOURCE_ROOT / ".venv/bin/python",
        SOURCE_ROOT / ".venv/Scripts/python.exe",
    )
    resolve_source = Path(__file__).resolve()
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            if sys.executable is not None and Path(sys.executable).resolve() == candidate.resolve():
                continue
            resolved_candidate = candidate.resolve()
            if resolved_candidate == resolve_source:
                continue
            _handoff(candidate, resolve_source)
    sys.stderr.write(_runtime_unavailable_message())
    raise SystemExit(1)


if str(CODE_ROOT) not in sys.path:
    sys.path.insert(0, str(CODE_ROOT))


def _usage() -> int:
    sys.stderr.write(
        "usage: ldvh capabilities [operation_key] [--request PATH] [--fields PATHS] | "
        "ldvh capabilities <operation_key> --example | "
        "ldvh call <operation_key> [--request PATH] [--fields PATHS] | "
        "ldvh check | "
        "ldvh {worktree-bootstrap,work-context,context-recovery,doctor,environment-sync,git-commit-msg,git-hook} ...\n"
    )
    return 2


def main() -> int:
    if len(sys.argv) < 2:
        return _usage()
    command = sys.argv[1]
    if command == "worktree-bootstrap":
        from ldvh.worktree_bootstrap import run as worktree_bootstrap_main

        return worktree_bootstrap_main(SOURCE_ROOT, sys.argv[2:])
    _ensure_dependency_runtime()
    if command in {"capabilities", "call", "check"}:
        from ldvh.cli import main as helper_main

        if command == "check":
            sys.argv = [sys.argv[0], "call", "check-current-governed-sources", *sys.argv[2:]]
        else:
            sys.argv = [sys.argv[0], *sys.argv[1:]]
        return helper_main()
    arguments = sys.argv[2:]
    if command == "environment-sync":
        from ldvh.environment_sync_cli import main as environment_sync_main

        return environment_sync_main(arguments)
    if command == "work-context":
        from ldvh.work_context import main as work_context_main

        return work_context_main(arguments)
    if command == "context-recovery":
        from ldvh.hooks.context_recovery import main as context_recovery_main

        return context_recovery_main(arguments)
    if command == "doctor":
        from ldvh.doctor import main as doctor_main

        return doctor_main(arguments)
    if command == "git-commit-msg":
        from ldvh.hooks.commit_msg import main as commit_msg_main

        return commit_msg_main(arguments)
    if command == "git-hook":
        from ldvh.git_hooks.commit_msg import main as git_hook_main

        return git_hook_main(arguments)
    return _usage()


if __name__ == "__main__":
    raise SystemExit(main())
